/* Сброс */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Переменные для удобства настройки цветов */
:root {
    --bg-main: #fffdf8;
    --bg-section: #fffaf4;
    --text-primary: #3d2e25;
    --text-heading: #5a3420;
    --accent-gold: #c49552;
    --accent-gold-hover: #a87d3e;
    --tg-color: #0088cc;
    --tg-color-hover: #0077b3;
    --wa-color: #25d366;
    --wa-color-hover: #1eaa53;
}

/* Основы */
html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--bg-main);
    color: var(--text-primary);
    line-height: 1.7;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Шапка */
.main-header {
    background: linear-gradient(135deg, #fff5e8, #fefcf8);
    text-align: center;
    padding: 60px 20px;
    border-bottom: 1px solid #f2e6d8;
}

.main-header h1 {
    font-size: 2.6rem;
    margin-bottom: 15px;
    color: var(--text-heading);
}

.main-header .subtitle {
    font-size: 1.2rem;
    color: #8a6a54;
    font-weight: 500;
    margin-bottom: 25px;
}

.brand {
    font-size: 0.9rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 15px;
    color: var(--accent-gold);
    font-weight: bold;
}

.header-messengers {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 20px;
}

/* Hero */
.hero {
    max-width: 1000px;
    margin: auto;
    padding: 60px 20px;
    text-align: center;
}

.hero h2 {
    font-size: 2rem;
    color: #6a4127;
    margin-bottom: 30px;
}

.hero .features p {
    max-width: 850px;
    margin: 15px auto;
    font-size: 1.1rem;
}

/* Общие стили кнопок */
.btn {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.3s, transform 0.2s, box-shadow 0.3s;
    text-align: center;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--accent-gold);
    color: #fff;
    margin-top: 25px;
    font-size: 1.1rem;
    padding: 14px 32px;
}

.btn-primary:hover {
    background: var(--accent-gold-hover);
    box-shadow: 0 5px 15px rgba(196, 149, 82, 0.4);
}

/* Мессенджеры — кнопки */
.btn-telegram {
    background: var(--tg-color);
    color: #fff;
}

.btn-telegram:hover {
    background: var(--tg-color-hover);
    box-shadow: 0 4px 12px rgba(0, 136, 204, 0.3);
}

.btn-whatsapp {
    background: var(--wa-color);
    color: #fff;
}

.btn-whatsapp:hover {
    background: var(--wa-color-hover);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
}

/* Каталог */
.catalog {
    padding: 60px 20px;
    background: var(--bg-section);
}

.catalog h2 {
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 40px;
    color: var(--text-heading);
}

/* Карточки */
.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.card {
    background: #ffffff;
    border-radius: 25px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
}

.card-img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
}

.card-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.card-content h3 {
    font-size: 1.5rem;
    color: var(--text-heading);
    margin-bottom: 12px;
}

.card-content p {
    color: #666;
    margin-bottom: 18px;
    flex-grow: 1;
}

/* Цена */
.price {
    display: inline-block;
    background: var(--accent-gold);
    color: #ffffff;
    padding: 8px 18px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 1.2rem;
    margin-bottom: 15px;
    width: fit-content;
}

/* Кнопки заказа в карточке */
.card-actions {
    display: flex;
    gap: 10px;
}

.btn-order {
    flex: 1;
    padding: 10px 0;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
    color: #fff;
    transition: background-color 0.3s, opacity 0.2s;
}

.btn-order.btn-tg {
    background: var(--tg-color);
}

.btn-order.btn-tg:hover {
    background: var(--tg-color-hover);
}

.btn-order.btn-wa {
    background: var(--wa-color);
}

.btn-order.btn-wa:hover {
    background: var(--wa-color-hover);
}

/* Секция контактов */
.contacts {
    padding: 60px 20px;
    text-align: center;
    background: var(--bg-main);
}

.contacts h2 {
    font-size: 2rem;
    color: var(--text-heading);
    margin-bottom: 15px;
}

.contacts p {
    font-size: 1.1rem;
    margin-bottom: 30px;
}

.contact-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.btn-telegram-lg, .btn-whatsapp-lg {
    padding: 16px 36px;
    font-size: 1.1rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    color: #fff;
    transition: background-color 0.3s, transform 0.2s, box-shadow 0.3s;
}

.btn-telegram-lg {
    background: var(--tg-color);
}

.btn-telegram-lg:hover {
    background: var(--tg-color-hover);
    box-shadow: 0 6px 20px rgba(0, 136, 204, 0.35);
}

.btn-whatsapp-lg {
    background: var(--wa-color);
}

.btn-whatsapp-lg:hover {
    background: var(--wa-color-hover);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
}

/* Подвал */
footer {
    background: #4a2a19;
    color: #d1bcac;
    text-align: center;
    padding: 25px 20px;
    font-size: 0.95rem;
}

/* Адаптивность для мобильных устройств */
@media (max-width: 600px) {
    .main-header h1 {
        font-size: 2rem;
    }

    .hero h2, .catalog h2, .contacts h2 {
        font-size: 1.6rem;
    }

    .card-actions {
        flex-direction: column;
    }

    .contact-links {
        flex-direction: column;
    }

    .btn-telegram-lg, .btn-whatsapp-lg {
        width: 100%;
    }
}
